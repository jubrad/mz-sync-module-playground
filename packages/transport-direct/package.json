{
  "name": "@mz-web/transport-direct",
  "version": "0.1.0",
  "description": "Direct WebSocket transport for Materialize — no mz-http proxy needed",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "SKIP_INTEGRATION=1 vitest run",
    "test:integration": "./tests/infra.sh test",
    "test:all": "vitest run",
    "infra:up": "./tests/infra.sh up",
    "infra:down": "./tests/infra.sh down",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@mz-web/subscribe": "file:../subscribe"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.22.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "ws": "^8.20.1"
  }
}
